// Key differences from PostgreSQL schema:
//  • No enum types (MongoDB/Prisma doesn't support enums)
//    — All enum fields are String with default string values
//  • All @id fields get @map("_id") — required by Prisma for MongoDB
//  • No prisma migrate — use `prisma db push` instead
//  • Transactions require a replica set (MongoDB Atlas always has one)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// MODELS 
// Role values:           "ADMIN" | "MEMBER"
// GoalStatus values:     "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED" | "AT_RISK"
// MilestoneStatus values:"PENDING" | "IN_PROGRESS" | "COMPLETED"
// Priority values:       "LOW" | "MEDIUM" | "HIGH" | "URGENT"
// ActionItemStatus values:"TODO" | "IN_PROGRESS" | "IN_REVIEW" | "DONE"

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  workspaceMembers    WorkspaceMember[]
  ownedGoals          Goal[]
  assignedActionItems ActionItem[]
  announcements       Announcement[]
  reactions           AnnouncementReaction[]
  comments            Comment[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  progressUpdates     ProgressUpdate[]
  invitationsSent     Invitation[]          @relation("InvitedBy")
}

model RefreshToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String?
  accentColor String   @default("#7C3AED")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  goals         Goal[]
  announcements Announcement[]
  actionItems   ActionItem[]
  activityLogs  ActivityLog[]
  invitations   Invitation[]
}

model WorkspaceMember {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  workspaceId String
  role        String   @default("MEMBER")  // "ADMIN" | "MEMBER"
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Invitation {
  id          String    @id @default(cuid()) @map("_id")
  email       String
  workspaceId String
  role        String    @default("MEMBER")  // "ADMIN" | "MEMBER"
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([email, workspaceId])
}

model Goal {
  id          String    @id @default(cuid()) @map("_id")
  title       String
  description String?
  status      String    @default("NOT_STARTED")  // GoalStatus
  dueDate     DateTime?
  workspaceId String
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User             @relation(fields: [ownerId], references: [id])
  milestones      Milestone[]
  actionItems     ActionItem[]
  progressUpdates ProgressUpdate[]
}

model Milestone {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  progress  Int      @default(0)
  status    String   @default("PENDING")   // MilestoneStatus
  goalId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model ProgressUpdate {
  id        String   @id @default(cuid()) @map("_id")
  content   String
  goalId    String
  userId    String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  content     String
  isPinned    Boolean  @default(false)
  workspaceId String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User                  @relation(fields: [authorId], references: [id])
  reactions AnnouncementReaction[]
  comments  Comment[]
}

model AnnouncementReaction {
  id             String   @id @default(cuid()) @map("_id")
  emoji          String
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId, emoji])
}

model Comment {
  id             String   @id @default(cuid()) @map("_id")
  content        String
  announcementId String
  authorId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
}

model ActionItem {
  id          String    @id @default(cuid()) @map("_id")
  title       String
  priority    String    @default("MEDIUM")  // Priority
  status      String    @default("TODO")    // ActionItemStatus
  dueDate     DateTime?
  workspaceId String
  assigneeId  String?
  goalId      String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id])
  goal      Goal?     @relation(fields: [goalId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid()) @map("_id")
  action      String
  entityType  String
  entityId    String
  workspaceId String
  userId      String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  type      String
  content   String
  isRead    Boolean  @default(false)
  userId    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
