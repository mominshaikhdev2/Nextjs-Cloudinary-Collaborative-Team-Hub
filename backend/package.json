{
  "name": "backend",
  "version": "1.0.0",
  "description": "Collaborative Team Hub REST API — PostgreSQL & MongoDB",
  "main": "src/index.js",
  "scripts": {
    "dev":                "nodemon src/index.js",
    "start":              "node src/index.js",

    "db:setup":           "node scripts/setup-db.js",
    "db:generate":        "node scripts/setup-db.js && prisma generate",
    "db:deploy":          "node scripts/setup-db.js && node scripts/db-deploy.js",

    "db:migrate":         "node scripts/setup-db.js && prisma migrate dev",
    "db:migrate:deploy":  "node scripts/setup-db.js && prisma migrate deploy",
    "db:push":            "node scripts/setup-db.js && prisma db push",
    "db:seed":            "node prisma/seed.js",
    "db:reset":           "node scripts/setup-db.js && prisma migrate reset",
    "db:studio":          "node scripts/setup-db.js && prisma studio",

    "build":              "node scripts/setup-db.js && prisma generate"
  },
  "dependencies": {
    "@prisma/client":        "^5.16.0",
    "bcryptjs":              "^2.4.3",
    "cloudinary":            "^1.41.0",
    "cookie-parser":         "^1.4.6",
    "cors":                  "^2.8.5",
    "dotenv":                "^17.4.2",
    "express":               "^4.19.2",
    "express-async-errors":  "^3.1.1",
    "express-rate-limit":    "^7.3.1",
    "express-validator":     "^7.1.0",
    "helmet":                "^7.1.0",
    "jsonwebtoken":          "^9.0.2",
    "morgan":                "^1.10.0",
    "multer":                "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer":            "^6.9.14",
    "socket.io":             "^4.7.5",
    "uuid":                  "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma":  "^5.16.0"
  }
}
